// What Rust tells the UI, and what the UI tells Rust. One global per screen: the screens read
// them directly, so nothing is passed down through intermediate components, and a preview can
// fill them with sample data (preview.slint).

/// One row of a list.
export struct EntryVm {
    /// The name without its extension, which is cut at the end when it is too long...
    stem: string,
    /// ...and the extension, which is always shown (".pdf"), or "".
    ext: string,
    /// The second line: "23 items • Oct 28, 2026".
    meta: string,
    /// Icon path data (Icons.folder or one picked by Rust).
    d: string,
    tint: color,
    selected: bool,
    /// A folder: its icon is drawn in the folder colour when `tint` is transparent.
    folder: bool,
    /// A picture drawn instead of the icon.
    thumb: image,
    has-thumb: bool,
}

/// One line of a sheet (a menu or a choice).
export struct SheetRow {
    label: string,
    /// Icon path data, or "" for none.
    d: string,
    /// Draws a check on the right: the current choice of a list of choices.
    checked: bool,
}

/// One line of the Properties sheet.
export struct PropRow {
    /// The name of the item (`kind` 0), a heading (1), or what the value is about (2).
    label: string,
    value: string,
    /// 0 the item's name, 1 a heading, 2 a label with its value.
    kind: int,
}

/// One icon of the folder icon picker.
export struct PickCell {
    /// Icon path data.
    d: string,
    label: string,
    /// The icon the folder has now.
    current: bool,
}

/// One of the quick-access tiles under the search pill.
export struct CategoryVm {
    label: string,
    d: string,
}

export global Nav {
    /// 0 Files, 1 Recent, 2 Starred, 3 Settings.
    in-out property <int> tab: 0;
    /// A folder is open on top of the tabs.
    in-out property <bool> browsing: false;
    /// "All files access" has not been granted: nothing else can be shown yet.
    in-out property <bool> permission-missing: false;
    callback tab-selected(int);
    /// The Back key (the Android backend reports it as a key press). Rust decides what it does.
    callback back-pressed();
    /// The "Allow access" button of the permission screen.
    callback allow-access();
}

/// One line of text that appears over the bottom of the screen for a moment. Rust sets `text`
/// and clears it again.
export global ToastState {
    in-out property <string> text;
}

export global HomeState {
    in-out property <[CategoryVm]> categories;
    in-out property <string> storage-name: "Internal Storage";
    in-out property <string> storage-usage;
    /// Used / total, 0..1.
    in-out property <float> storage-fraction: 0.0;
    in-out property <[EntryVm]> folders;
    callback search-clicked();
    callback more-clicked();
    callback category-clicked(int);
    callback storage-clicked();
    callback folder-clicked(int);
    callback folder-menu(int);
}

export global BrowseState {
    in-out property <string> title;
    in-out property <string> subtitle;
    in-out property <[EntryVm]> rows;
    /// "This folder is empty.", "Loading...", or "" while there are rows.
    in-out property <string> empty-text;
    /// How far the list is scrolled (0 at the top, negative below it). Two-way bound to the
    /// list, so Rust reads it to remember a place and writes it to go back to one.
    in-out property <length> scroll-y;
    /// The first row in view and how many rows fit, kept up to date by the list. Rust reads
    /// them to know which rows to fetch sizes and dates for first.
    in-out property <int> view-first;
    in-out property <int> view-count;
    /// Rows are selected: the bar shows how many, and the left button clears the selection.
    in-out property <bool> selecting: false;
    in-out property <int> selected-count: 0;
    /// The search field is open under the bar.
    in-out property <bool> searching: false;
    /// The rows are the inside of an archive: nothing can be made or pasted there.
    in-out property <bool> in-archive: false;
    /// Something is held by Copy or Move and nothing is selected: the paste bar shows. "" for no
    /// paste bar, otherwise its first line ("Copying 3 items").
    in-out property <string> paste-title;
    /// The folder the items would go into, after "Into ".
    in-out property <string> paste-into;
    /// The confirm button: "Paste here" or "Move here".
    in-out property <string> paste-label;
    /// `view-first` or `view-count` changed.
    callback viewed();
    /// A tile of the selection bar: 0 Copy, 1 Move, 2 Delete, 3 Pack.
    callback bar-clicked(int);
    callback paste-clicked();
    callback paste-cancelled();
    callback paste-new-folder();
    /// The "+ New" button.
    callback new-clicked();
    callback back-clicked();
    callback search-clicked();
    callback sort-clicked();
    callback more-clicked();
    /// The text of the search field changed.
    callback query-edited(string);
    callback row-clicked(int);
    callback row-long-pressed(int);
    callback row-menu(int);
}

/// A modal sheet: a menu or a choice over the whole window. Rust fills it and opens it, and the
/// sheet only says which line was tapped (`picked`) or that it was backed out of (`dismissed`).
export global SheetState {
    in-out property <bool> open: false;
    in-out property <string> title;
    in-out property <[SheetRow]> rows;
    /// Lines of text under the title (one line of the card each), or none.
    in-out property <[string]> body-lines;
    /// A text button under the lines that backs out, or "" for none.
    in-out property <string> cancel-label;
    callback picked(int);
    callback dismissed();
}

/// The Properties sheet: a card with the facts about the selection, a check box for a folder's
/// `.nomedia` file, and Copy / OK. Rust fills `rows` (and changes a value when a slow answer
/// arrives) and opens it. OK, the Back key and a tap outside all report `ok-clicked`.
export global PropsState {
    in-out property <bool> open: false;
    in-out property <[PropRow]> rows;
    /// Show the "Disable media scanning" box (a single folder).
    in-out property <bool> has-nomedia: false;
    in-out property <bool> nomedia: false;
    callback copy-clicked();
    callback ok-clicked();
    /// The box was tapped; the argument is what it should become.
    callback nomedia-toggled(bool);
}

/// The folder icon picker: a card with a row of colour swatches (not for a bookmark), a grid of
/// icons, and "Use default" / "Cancel". Rust fills it and opens it. A swatch keeps the sheet open
/// (Rust saves the colour and moves the tick); an icon, a button, Back and a tap outside are for
/// Rust to act on.
export global PickState {
    in-out property <bool> open: false;
    /// "Icon and color for Music" (with swatches) or "Icon for Music".
    in-out property <string> title;
    in-out property <bool> has-colors: false;
    /// The colours after the first swatch; the first ("default") is drawn in the accent colour.
    in-out property <[color]> colors;
    /// The swatch with the ring and the tick: 0 is "default", 1.. follow `colors`, -1 none.
    in-out property <int> color-index: 0;
    /// What the icons are drawn in: the folder's colour, else the accent.
    in-out property <color> tint: #808080;
    in-out property <[PickCell]> cells;
    callback swatch-clicked(int);
    callback icon-clicked(int);
    callback default-clicked();
    callback cancelled();
}

/// A file operation that has lasted a moment (Delete, Copy, Move): a card over the whole window
/// with what is being done, the file in hand, the percent and a bar, and Cancel. Rust fills it
/// and opens it (after 250 ms, so a quick operation never shows it). Back and a tap outside do
/// nothing; only Cancel (`cancel-clicked`) ends it early, and Rust then keeps the card up until
/// the work has stopped.
export global ProgressState {
    in-out property <bool> open: false;
    /// "Deleting...", "Copying...", "Moving...".
    in-out property <string> title;
    /// The file being worked on, or "Cancelling...".
    in-out property <string> line;
    /// "42%", or "" while the amount is not known.
    in-out property <string> percent;
    /// How much of the work is done, 0..1 (read only while `indeterminate` is false).
    in-out property <float> frac: 0.0;
    /// The amount is not known: the bar slides instead of filling.
    in-out property <bool> indeterminate: true;
    /// False once Cancel was tapped.
    in-out property <bool> cancel-enabled: true;
    callback cancel-clicked();
}

/// A question or a message in the middle of the window: a title, some text, and one or two
/// buttons. Rust fills it and opens it; the dialog only says which button was tapped. A tap
/// outside the card counts as Cancel (or as OK when there is no Cancel).
export global DialogState {
    in-out property <bool> open: false;
    in-out property <string> title;
    in-out property <string> body;
    /// "" for a message that has only its one button.
    in-out property <string> cancel-label;
    in-out property <string> confirm-label;
    /// The confirm button is drawn in the danger colour.
    in-out property <bool> danger: false;
    /// A text field under the text (a name to type). Rust sets `field-text` to what it starts with
    /// and reads it back on `confirmed`.
    in-out property <bool> field: false;
    in-out property <string> field-text;
    /// What the empty field says, and whether what is typed is hidden (a password).
    in-out property <string> placeholder: "Name";
    in-out property <bool> password: false;
    /// Where the text of the field starts out selected to, as a byte offset into `field-text`
    /// (Rename leaves the extension out); -1 selects all of it. Rust sets it before `field`.
    in-out property <int> select-to: -1;
    /// A red line under the field, or "". Typing in the field clears it.
    in-out property <string> error;
    callback confirmed();
    callback cancelled();
}
