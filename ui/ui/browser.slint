// The file list of the main screen.
//
// Only the rows that are on screen are built: the list is a Flickable whose content is as tall as
// all the rows together, and a `for` over the few rows in view places each one at its slot. Every
// row has the same height (a row's height is its text's, and all rows of a list have the same
// lines), measured once on a hidden probe row.

import { Theme } from "theme.slint";
import { KListRow } from "components.slint";

/// One row, as the Rust side describes it.
export struct RowData {
    icon: string,
    /// 0: the accent colour, 1: the secondary text colour, 2: `tint`.
    tint-kind: int,
    tint: color,
    name: string,
    detail: string,
    where-line: string,
    size-text: string,
    selected: bool,
}

/// The thumbnail of the row with the same index in `rows`, drawn instead of the icon while `has`
/// (and the row is not selected). It is a model of its own so that a thumbnail arriving changes
/// nothing a row's texts depend on: a change of any row of a model makes every row view that
/// reads the model evaluate its bindings again.
export struct PreviewData {
    image: image,
    has: bool,
}

export component KFileList inherits Rectangle {
    in property <[RowData]> rows;
    /// The thumbnails, one per entry of `rows` (see `PreviewData`).
    in property <[PreviewData]> previews;
    /// The ".." row above the first row.
    in property <bool> up-row: false;
    /// Search hits show the folder they live in on a third line.
    in property <bool> has-where: false;
    /// Room under the last row: 10 dp, more while the bottom bar covers it.
    in property <length> bottom-pad: 10px;
    /// The info strip behind the list may be pulled into view (nothing selected, access granted).
    in property <bool> pull-enabled: false;
    /// Settings > Rows on screen: about this many rows fit the room of the list (0 = natural height).
    in property <int> rows-fit: 0;
    /// The colour of the ".." row's icon (Settings > Default folder color).
    in property <color> up-tint: Theme.accent;
    /// The space between two rows (part of each row's slot, so it is also part of `row-h`).
    in property <length> row-gap: 6px;
    /// A tap; the index is into `rows`, or -1 for the ".." row.
    callback row-clicked(int);
    callback row-long-pressed(int);
    /// The list was scrolled (for the "+ New" button, which hides while scrolling down).
    callback scrolled(length);
    /// A pull down from the top began: fill the info strip.
    callback pull-started();
    /// The pull ended; `refresh` is true when it was long enough to reload the folder.
    callback pull-ended(bool);
    /// The slots that are built changed: the index of the first one and how many there are (the
    /// ".." row is a slot). Thumbnails are only asked for the rows in view.
    callback visible-changed(int, int);
    out property <length> scroll-pos: Math.max(0px, -flick.content-y - root.slack);
    /// How far the finger has pulled the list down from the top (1:1).
    out property <length> over: Math.max(0px, flick.content-y + root.slack);
    /// How far the list is shown moved down: 0.6 of the pull, at most 84 dp (`PULL_H`), and back to
    /// 0 when the finger lets go (220 ms, after 250 ms when the strip was almost fully out).
    /// Only a pull that began with the list resting at the top (`held`) moves the list: a fling
    /// that runs into the top is stopped there instead (see `changed content-y`).
    out property <length> shift: root.releasing || !root.pull-enabled || !root.held ? 0px : Math.min(root.over * 0.6, 84px);
    /// A pull is going on: the finger is down, or has only just left.
    in-out property <bool> held: false;

    // The Flickable cannot be dragged past its top, so its content starts `slack` (84 dp / 0.6)
    // below the top of the viewport and rests scrolled by that much; dragging down uses up the slack.
    property <length> slack: 140px;
    property <bool> releasing: false;
    property <bool> full: false;
    property <int> still: 0;
    // A pull may only begin when the list was already resting at the top: it has not been
    // anywhere else for 180 ms. A fast fling that arrives at the top is still "moving" and so
    // never opens the info strip or refreshes; it just stops at the top like any other scroll.
    property <bool> top-rest: true;
    // The last scroll position handed to Rust (it only cares about steps of 6 dp).
    property <length> last-sent: 0px;
    // Opening another folder: the rows fade out while it is read and fade in, already at the top,
    // when it is here, so that the swap happens out of sight. `up-live` is the ".." row as the
    // rows on screen have it: it only follows `up-row` while the list is not faded out, so the
    // old rows do not jump by a row when the top bar already shows the new folder.
    in-out property <bool> faded: false;
    // Which way the move goes: 1 deeper (a folder or an archive is opened), -1 back out. The new
    // rows come in from that side.
    in-out property <int> nav-dir: 1;
    property <bool> up-live: false;
    property <length> enter-dy: root.faded ? 8px : 0px;
    property <length> enter-dx: root.faded ? root.nav-dir * 24px : 0px;
    // The biggest height the list has had, so opening the search row or a banner does not resize
    // the rows; a new width (a rotation) starts again.
    property <length> room: 0px;
    property <length> row-h: root.rows-fit > 0 ? Math.max(24px, root.room / root.rows-fit) : probe.preferred-height;
    property <int> total: root.rows.length + (root.up-live ? 1 : 0);
    // The first row that is built: two above the top of the view. This is not a binding on the
    // scroll position: a binding on `flick.content-y` is flagged as stale on every frame of a
    // scroll, and with it the binding of every property of every row view (names, details, icons,
    // previews and the measuring of each text below them), though only one row view changes at a
    // row boundary. `sync-first` sets it instead, and only a changed row number notifies anyone.
    property <int> first: 0;
    property <int> shown: Math.max(0, Math.min(root.total - root.first, Math.ceil(root.height / root.row-h) + 4));
    // How many row views are built: enough for the rows in view and a few over, and always the same
    // number while the list is scrolled. Row `at` is built by view `at mod slots`, so scrolling
    // by one row hands ONE view to the row that comes into view and leaves every other view as it
    // is. (If views were numbered from `first`, every view would get another row each time the
    // list moved by one row, and every one of them would lay its texts out again: that was a
    // stutter on every row boundary of a fast scroll.)
    // The rows built reach two above and two below the view: `first` follows the scroll position a
    // moment after it, and the extra rows cover that moment.
    property <int> slots: Math.max(0, Math.min(root.total, Math.ceil(root.height / root.row-h) + 5));

    // transparent: the info strip shows through above the rows while the list is pulled down
    clip: true;

    animate shift {
        duration: root.releasing ? Theme.dur(220ms) : 0ms;
        delay: root.full ? 250ms : 0ms;
        easing: ease-in-out-sine;
    }

    animate enter-dy, enter-dx {
        duration: root.faded ? Theme.dur(70ms) : Theme.dur(220ms);
        easing: ease-out;
    }

    init => {
        flick.content-y = -root.slack;
        root.sync-first();
        root.room = root.height;
        root.up-live = root.up-row;
    }

    changed up-row => {
        if (!root.faded) {
            root.up-live = root.up-row;
        }
    }

    changed height => {
        if (root.height > root.room) {
            root.room = root.height;
        }
    }

    changed width => {
        root.room = root.height;
    }

    changed row-h => {
        root.sync-first();
    }

    /// Work out which row is the first one that is built (see `first`).
    function sync-first() {
        root.first = Math.max(0, Math.floor((-flick.content-y - root.slack) / root.row-h) - 2);
    }

    changed first => {
        root.visible-changed(root.first, root.shown);
    }

    changed shown => {
        root.visible-changed(root.first, root.shown);
    }

    /// Another folder is being opened (`dir` 1) or left (`dir` -1): let the rows on screen fade out.
    public function fade-out(dir: int) {
        root.nav-dir = dir;
        root.faded = true;
    }

    /// The rows of the folder are in place: show them (sliding up a little as they fade in).
    public function fade-in() {
        root.reveal();
    }

    function reveal() {
        root.up-live = root.up-row;
        root.faded = false;
    }

    /// Scroll to the very top (a new folder always starts there).
    public function scroll-top() {
        flick.content-y = -root.slack;
        root.sync-first();
    }

    /// Scroll to `y` dp from the top (Back returns to where the folder was left).
    public function scroll-to(y: length) {
        flick.content-y = -(y + root.slack);
        root.sync-first();
    }

    /// The finger let go (or has not moved for a while): hand the list back and say so.
    function release() {
        root.held = false;
        root.top-rest = false;
        root.full = root.over * 0.6 >= 84px * 0.9;
        root.releasing = true;
        root.pull-ended(root.over * 0.5 > 64px);
        flick.content-y = -root.slack;
    }

    // Is a finger on the list? A TouchArea around the Flickable sees the pointer while it is
    // inside, even while the Flickable has the drag.
    // It ticks every frame, so a lifted finger is noticed after about 3 frames (48 ms) and not after
    // 150-200 ms: `release` is what starts the refresh. Holding still for 2 s still lets go.
    Timer {
        interval: 16ms;
        running: root.held;
        triggered => {
            root.still += 1;
            if ((!touch.has-hover && root.still >= 3) || root.still >= 125) {
                root.release();
            }
        }
    }

    // The list counts as resting at the top once it has stayed there for 180 ms.
    Timer {
        interval: 180ms;
        running: !root.top-rest && !root.held && root.over <= 0px && root.scroll-pos <= 0.5px;
        triggered => {
            root.top-rest = true;
        }
    }

    // A folder that never answers must not leave the list invisible.
    Timer {
        interval: 8000ms;
        running: root.faded;
        triggered => {
            root.reveal();
        }
    }

    // covers what is below the rows, from the top of the list as it is shown
    Rectangle {
        y: root.shift;
        height: parent.height - root.shift;
        background: Theme.bg;
    }

    // The row that gives every row its height; never seen.
    probe := KListRow {
        visible: false;
        y: -1000px;
        width: root.width;
        name: "Wg";
        detail: "Wg";
        where-line: root.has-where ? "Wg" : "";
        size-text: "1 B";
        gap: root.row-gap;
    }

    touch := TouchArea {
        // A finger that comes down on a list that is already at the top may pull at once: no fling
        // can be going on, because a fling has no finger. (The 180 ms rest above is then only for
        // a pull that begins some other way.)
        changed has-hover => {
            if (self.has-hover && !root.held && root.over <= 0px && root.scroll-pos <= 0.5px) {
                root.top-rest = true;
            }
        }

        flick := Flickable {
            content-width: root.width;
            content-height: Math.max(root.slack + root.total * root.row-h + root.bottom-pad, root.height + root.slack);
            opacity: root.faded ? 0 : 1;
            animate opacity {
                duration: root.faded ? Theme.dur(70ms) : Theme.dur(180ms);
                easing: ease-out;
            }
            changed content-y => {
                root.sync-first();
                if (root.scroll-pos > 0.5px) {
                    root.top-rest = false;
                }
                // Rust only wants to hear about steps of 6 dp (it hides "+ New" while scrolling)
                if (Math.abs((root.scroll-pos - root.last-sent) / 1px) >= 6 || (root.scroll-pos <= 0px && root.last-sent > 0px)) {
                    root.last-sent = root.scroll-pos;
                    root.scrolled(root.scroll-pos);
                }
                if (root.over > 0px) {
                    if (root.held) {
                        root.still = 0;
                    } else if (root.top-rest) {
                        // a pull: it began with the list resting at the top
                        root.still = 0;
                        root.held = true;
                        root.releasing = false;
                        root.full = false;
                        if (root.pull-enabled) {
                            root.pull-started();
                        }
                    } else {
                        // a fling (or a drag that began further down) ran past the top: stop it there
                        flick.content-y = -root.slack;
                    }
                }
            }

            for slot in root.slots: KListRow {
                // the row this view builds: the one at or after `first` whose number is `slot` mod `slots`
                property <int> at: root.first + Math.floor(Math.mod(slot + root.slots - Math.mod(root.first, root.slots), root.slots));
                visible: self.at < root.total;
                property <int> idx: self.at - (root.up-live ? 1 : 0);
                property <bool> is-up: root.up-live && self.at == 0;
                property <RowData> d: root.rows[self.idx];
                property <PreviewData> pv: root.previews[self.idx];
                x: root.enter-dx;
                y: root.slack + root.shift - root.over + self.at * root.row-h + root.enter-dy;
                width: root.width;
                height: root.row-h;
                gap: root.row-gap;
                icon: self.is-up ? "up_dir" : self.d.icon;
                fit-h: root.rows-fit > 0 ? root.row-h : 0px;
                icon-tint: self.is-up ? root.up-tint : self.d.tint-kind == 0 ? Theme.accent : self.d.tint-kind == 1 ? Theme.text2 : self.d.tint;
                name: self.is-up ? ".." : self.d.name;
                detail: self.is-up ? "" : self.d.detail;
                where-line: self.is-up ? "" : self.d.where-line;
                size-text: self.is-up ? "" : self.d.size-text;
                selected: !self.is-up && self.d.selected;
                preview: self.pv.image;
                has-preview: !self.is-up && self.pv.has;
                clicked => {
                    root.row-clicked(self.is-up ? -1 : self.idx);
                }
                long-pressed => {
                    if (!self.is-up) {
                        root.row-long-pressed(self.idx);
                    }
                }
            }
        }
    }
}
