<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="k_light_bars">true</bool>

    <!-- No window animations anywhere: the app should feel plain and quick. -->
    <style name="KilnTheme" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@color/k_bg</item>
        <item name="android:statusBarColor">@color/k_bg</item>
        <item name="android:navigationBarColor">@color/k_bg</item>
        <item name="android:windowLightStatusBar">@bool/k_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/k_light_bars</item>
        <item name="android:colorAccent">@color/k_accent</item>
        <item name="android:colorControlActivated">@color/k_accent</item>
        <item name="android:textColorPrimary">@color/k_text</item>
        <item name="android:textColorSecondary">@color/k_text2</item>
        <item name="android:textColor">@color/k_text</item>
        <item name="android:textColorHint">@color/k_text2</item>
    </style>

    <style name="KilnSheet" parent="android:Theme.DeviceDefault.Light.Dialog.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:colorAccent">@color/k_accent</item>
        <item name="android:colorControlActivated">@color/k_accent</item>
        <item name="android:textColorPrimary">@color/k_text</item>
        <item name="android:textColorSecondary">@color/k_text2</item>
        <item name="android:textColor">@color/k_text</item>
        <item name="android:textColorHint">@color/k_text2</item>
    </style>
</resources>
