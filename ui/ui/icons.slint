    /// True for the icons whose drawable says fillType="evenOdd".
    pure public function even-odd(name: string) -> bool {
        name == "d_android" ||
        name == "d_bell" ||
        name == "d_camera" ||
        name == "d_code" ||
        name == "d_documents" ||
        name == "d_download" ||
        name == "d_heart" ||
        name == "d_lock" ||
        name == "d_movies" ||
        name == "d_music" ||
        name == "d_phone" ||
        name == "d_pictures" ||
        name == "d_sd" ||
        name == "d_star" ||
        name == "d_zip" ||
        name == "f_apk" ||
        name == "f_bin" ||
        name == "f_book" ||
        name == "f_db" ||
        name == "f_disk" ||
        name == "f_doc" ||
        name == "f_font" ||
        name == "f_key" ||
        name == "f_pdf" ||
        name == "f_sheet" ||
        name == "f_slides" ||
        name == "f_term" ||
        name == "f_text" ||
        name == "f_web" ||
        name == "f_zip";
    }
