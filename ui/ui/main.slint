import { ArcTile } from "components.slint";
export { ArcTile }

// The main window (MainActivity.buildUi()): the top bar, the search row, the rule under them, the
// warning banner, the body (the info strip behind the file list, the file list, the refresh
// circle, the empty-folder line, the "+ New" button, the selection bar and the opaque permission
// view), the bookmarks drop-down, the sort sheet, a message sheet and a toast layer. The menus come
// in the next parts of Phase B. See docs/UI-SPEC.md, section "Main screen".

import { Theme } from "theme.slint";
import { DetailRow, Icon, KButton, KCheck, KDetailCard, KFab, KMeter, KProgressBar, KSheet, KSheetOption, KSheetText, KStatTile, KTextField, KTile, KToast, KTopBar, PressArea, KMark } from "components.slint";
import { KFileList, RowData } from "browser.slint";
import { KMarksPopup, MarkRow } from "marks.slint";
import { KPullPanel, KRefreshCircle } from "pull.slint";

/// One line of the Properties sheet (Props.Box): `kind` 0 is the name line, 1 a heading (`label`
/// only), 2 a "label  value" row.
export struct PropRow {
    label: string,
    value: string,
    kind: int,
}

/// One icon of the folder icon picker: its icon name, its label, and whether it is the current one.
export struct PickIcon {
    icon: string,
    label: string,
    current: bool,
}

/// One colour of the picker's swatch row (iconPicker): a 42 dp tall cell with a 34 dp circle,
/// 3 dp in the text colour and a white tick when it is the current one, else 1 dp in k_line.
component KSwatch inherits Rectangle {
    in property <color> dot;
    in property <bool> current: false;
    callback clicked();
    preferred-height: 42px;
    preferred-width: 0px;
    min-width: 0px;
    horizontal-stretch: 1;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 4px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: root.dot;
        border-width: root.current ? 3px : Theme.hair;
        border-color: root.current ? Theme.text : Theme.line;
        if root.current: Text {
            width: parent.width;
            height: parent.height;
            text: "\u{2713}";
            color: #ffffff;
            font-size: Theme.sp(16px);
            font-weight: Theme.bold;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    PressArea {
        width: 100%;
        height: 100%;
        radius: 21px;
        clicked => {
            root.clicked();
        }
    }
}

/// One icon cell of the picker grid: 2 dp margin, radius 12, padding 2 / 8 / 2 / 6, a 40 dp icon
/// over the label (11 sp, one line). The current one has a k_chip fill and an accent outline and
/// a bold label in the normal text colour.
component KPickCell inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> current: false;
    in property <color> tint: Theme.accent;
    callback clicked();
    preferred-width: 0px;
    min-width: 0px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 2px;
        Rectangle {
            border-radius: 12px;
            background: root.current ? Theme.chip : transparent;
            border-width: root.current ? Theme.hair : 0px;
            border-color: Theme.accent;
            VerticalLayout {
                padding-left: 2px;
                padding-top: 8px;
                padding-right: 2px;
                padding-bottom: 6px;
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Icon {
                        width: 40px;
                        height: 40px;
                        name: root.icon;
                        tint: root.tint;
                    }
                }
                Text {
                    text: root.label;
                    color: root.current ? Theme.text : Theme.text2;
                    font-size: Theme.sp(11px);
                    font-weight: root.current ? Theme.bold : 400;
                    horizontal-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
            PressArea {
                width: 100%;
                height: 100%;
                radius: 12px;
                clicked => {
                    root.clicked();
                }
            }
        }
    }
}

// The Rust side drives the theme (dark mode, font scale, density, animation speed) through this.
export { DetailRow, MarkRow, RowData, Theme }


/// A text field with the red line under it that `EditText.setError` gives in the Java. Typing
/// clears the line.
component KFormField inherits VerticalLayout {
    in property <string> placeholder;
    in property <bool> secret: false;
    in-out property <string> text;
    in-out property <string> error;
    spacing: 4px;
    KTextField {
        placeholder: root.placeholder;
        secret: root.secret;
        text <=> root.text;
        edited => {
            root.error = "";
        }
    }
    if root.error != "": Text {
        text: root.error;
        color: Theme.danger;
        font-size: Theme.sp(12px);
        wrap: word-wrap;
    }
}

/// One option row of the dialog sheet (`Sheet.option`); an empty icon means no tile.
export struct DlgOption {
    icon: string,
    label: string,
    sub: string,
    selected: bool,
}

export component MainWindow inherits Window {
    // ---- what the Rust side sets ---------------------------------------------------------------
    /// Top bar title (19 sp bold) and the line under it (12 sp, the folder path).
    in property <string> bar-title: "Kiln";
    in property <string> bar-sub;
    /// At a storage root the Kiln mark is the left button; elsewhere it is the "up" arrow.
    in property <bool> home: true;
    /// The little arrow after the title, and whether tapping the title opens the bookmarks. Both
    /// are on only when storage access is granted, not selecting and not inside an archive.
    in property <bool> marks-ok: false;
    /// The magnifier turns into a cross while searching, and the search row is open.
    in property <bool> searching: false;
    /// While rows are selected the left button is a cross and sort and search are hidden.
    in property <bool> selecting: false;
    /// The left button's icon: "up", or "close" while selecting (the Kiln mark at home).
    in property <string> left-icon: "up";
    /// The warning line under the rule ("Plain view of an encrypted set...").
    in property <string> banner-text;
    /// The file list.
    in property <[RowData]> rows;
    in property <bool> up-row: false;
    in property <bool> has-where: false;
    /// The selection bar (Copy, Move, Delete, Pack) is up.
    in property <bool> bar-shown: false;
    in property <bool> arc-bar-shown: false;
    in property <[ArcTile]> arc-tiles;
    in property <bool> arc-dirty: false;
    callback arc-save-clicked();
    callback arc-discard-clicked();
    callback arc-tile-clicked(int);
    /// Copy or Move is holding items: the bar shows the paste row instead of the four tiles.
    in property <bool> paste-mode: false;
    in property <string> paste-title;
    in property <string> paste-sub;
    in property <string> paste-here-text;
    in property <bool> sort-sheet-shown: false;
    in property <int> sort-key: 0;
    in property <bool> sort-asc: true;
    /// The line in the middle of the body ("Starting...", or "Kiln couldn't start: ...").
    in property <string> empty-text: "Starting...";
    /// How far down it sits: 56 dp, or 96 dp when the ".." row is showing.
    in property <length> empty-top: 56px;
    /// True until "All files access" is granted: the opaque permission view covers the body.
    in property <bool> permission-missing: false;
    in property <bool> fab-shown: false;
    in property <string> toast-text;
    in property <bool> toast-shown: false;
    /// MainActivity.message(heading, body): a sheet with the text and one filled "OK" button.
    in property <bool> sheet-shown: false;
    in property <string> sheet-title;
    in property <string> sheet-body;
    /// The dialog sheet (Sheet.java): a title, a line of text, an optional text field, buttons.
    in property <bool> dlg-shown: false;
    in property <string> dlg-title;
    in property <string> dlg-body;
    in property <bool> dlg-has-field: false;
    in property <bool> dlg-secret: false;
    in property <string> dlg-placeholder;
    /// What is in the field: Rust sets the start text and reads it when a button is tapped.
    in-out property <string> dlg-text;
    /// A line under the field in the danger colour (EditText.setError). Typing clears it.
    in-out property <string> dlg-error;
    in property <int> dlg-select-end: 0;
    in property <[string]> dlg-buttons;
    in property <[int]> dlg-kinds;
    in property <bool> dlg-cancelable: true;
    /// Option rows between the text and the field.
    in property <[DlgOption]> dlg-options;
    /// The progress sheet (MainActivity.ProgressUi): a title, the file line, the percent and a bar.
    /// The percent is empty and the bar indeterminate until the first report; Cancel is left out
    /// when `prog-cancellable` is false and greys out when `prog-cancel-enabled` is false.
    in property <bool> prog-shown: false;
    in property <string> prog-title;
    in property <string> prog-line;
    in property <string> prog-pct;
    in property <float> prog-frac: 0;
    in property <bool> prog-indeterminate: true;
    in property <bool> prog-cancellable: true;
    in property <bool> prog-cancel-enabled: true;
    property <[string]> prog-no-buttons: [];
    /// The folder icon picker (MainActivity.iconPicker): a title, an optional row of colour swatches
    /// (folders in the list, not bookmarks), then the icons, 4 to a row.
    in property <bool> pick-shown: false;
    in property <string> pick-title;
    in property <bool> pick-has-colors: false;
    /// The colours after the first swatch; the first ("default") is drawn in the accent colour.
    in property <[color]> pick-colors;
    /// The swatch with the ring and the tick: 0 is "default", 1.. follow `pick-colors`, -1 none.
    /// The icons below are tinted with it (accent for 0 and -1).
    in property <int> pick-color-index: -1;
    in property <[PickIcon]> pick-icons;
    property <color> pick-tint: root.pick-color-index > 0 ? root.pick-colors[root.pick-color-index - 1] : Theme.accent;
    /// The Properties sheet (Props.show): the lines, and for a folder the "Disable media scanning"
    /// check box under them. Rust puts the box back if the file could not be changed.
    in property <bool> props-shown: false;
    in property <[PropRow]> props-rows;
    in property <bool> props-has-nomedia: false;
    in-out property <bool> props-nomedia: false;
    /// The Pack sheet (MainActivity.packDialog): the title, the fields (Rust sets the start text
    /// and reads them when Create is tapped), a red line under each field, the boxes and a note.
    in property <bool> pack-shown: false;
    in property <string> pack-title;
    in-out property <string> pack-name;
    in-out property <string> pack-where;
    in-out property <string> pack-pw1;
    in-out property <string> pack-pw2;
    in-out property <string> pack-name-error;
    in-out property <string> pack-where-error;
    in-out property <string> pack-pw1-error;
    in-out property <string> pack-pw2-error;
    in-out property <bool> pack-enc: true;
    in-out property <bool> pack-show-pw: false;
    in-out property <bool> pack-store: false;
    in-out property <bool> pack-each: false;
    in-out property <bool> pack-wipe: false;
    in property <string> pack-note;
    /// The Pack result sheet (MainActivity.packResult): the head, three number tiles and the
    /// compression card (only when `pack-res-has-stats`), then the detail rows.
    in property <bool> pack-res-shown: false;
    in property <string> pack-res-icon: "archive";
    in property <string> pack-res-heading;
    in property <string> pack-res-name;
    in property <bool> pack-res-has-stats: false;
    in property <string> pack-res-n-big;
    in property <string> pack-res-n-label;
    in property <string> pack-res-stored;
    in property <string> pack-res-time;
    in property <string> pack-res-saved;
    in property <float> pack-res-frac: 0;
    in property <string> pack-res-caption;
    in property <[DetailRow]> pack-res-rows;
    /// The About sheet (MainActivity.showAbout): the chip's text and the detail rows.
    in property <bool> about-shown: false;
    in property <string> about-version;
    in property <[DetailRow]> about-rows;
    /// Pulses the Kiln mark (glowMark): flip to false, then back to true.
    in-out property <bool> glow-run: true;
    /// The info strip behind the list (pullPanel): its lines, and how full the storage is (0..1).
    in property <bool> pull-enabled: false;
    in property <string> pull-type;
    in property <string> pull-free;
    in property <string> pull-name;
    in property <string> pull-size;
    in property <float> pull-used: 0;
    /// The refresh circle is turning (SwipeRefreshLayout.setRefreshing); the pull sets it, and the
    /// Rust side clears it when the folder has been read.
    in-out property <bool> refreshing: false;
    /// The bookmarks drop-down: its lines, and the action under them.
    in property <bool> marks-shown: false;
    in property <[MarkRow]> mark-rows;
    in property <bool> mark-has-action: false;
    in property <string> mark-action-icon: "add";
    in property <string> mark-action-label;

    // ---- what the UI tells the Rust side -------------------------------------------------------
    callback allow-access();
    callback left-clicked();
    callback titles-clicked();
    callback search-clicked();
    callback sort-clicked();
    callback more-clicked();
    callback new-clicked();
    callback sheet-dismissed();
    callback row-clicked(int);
    callback row-long-pressed(int);
    callback list-scrolled(length);
    callback query-edited(string);
    callback bar-clicked(int);
    callback paste-new-folder();
    callback paste-cancel();
    callback paste-here();
    callback sort-key-chosen(int);
    callback sort-asc-chosen(bool);
    callback sort-dismissed();
    callback pull-started();
    /// The finger let go of a pull (the info strip may stop counting).
    callback pull-ended();
    /// A pull was long enough: read the folder again.
    callback refresh-requested();
    callback marks-dismissed();
    callback mark-clicked(int);
    callback mark-removed(int);
    callback mark-icon-clicked(int);
    callback mark-action-clicked();
    callback dlg-button-clicked(int);
    callback dlg-cancelled();
    callback dlg-option-clicked(int);
    /// The progress sheet's Cancel was tapped.
    callback prog-cancel-clicked();
    /// The folder icon picker: a swatch (0 = default), an icon, a button (0 = Use default, 1 = Cancel),
    /// and a tap outside the card.
    callback pick-swatch-clicked(int);
    callback pick-icon-clicked(int);
    callback pick-button-clicked(int);
    callback pick-cancelled();
    /// The Properties sheet: a button (0 = Copy, 1 = OK), the check box turned on or off, and a tap
    /// outside the card.
    callback props-button-clicked(int);
    callback props-nomedia-toggled(bool);
    callback props-cancelled();
    /// The Pack sheet: a button (0 = Cancel, 1 = Create), Browse, "Encrypt" or "Separate archive"
    /// turned on or off (Rust fixes the name and the note), and a tap outside the card.
    callback pack-button-clicked(int);
    callback pack-browse-clicked();
    callback pack-options-changed();
    callback pack-cancelled();
    /// The Pack result sheet: OK, or a tap outside the card.
    callback pack-res-dismissed();
    /// The About sheet: OK, or a tap outside the card.
    callback about-dismissed();
    /// The Back key or gesture (MainActivity.onBackPressed).
    callback back-pressed();

    /// Scroll the file list to the top, or to `y` dp from it.
    public function scroll-list-top() {
        list.scroll-top();
    }
    public function scroll-list-to(y: length) {
        list.scroll-to(y);
    }
    /// How far the file list is scrolled, in dp.
    out property <length> list-pos: list.scroll-pos;
    /// Give the Back key a place to arrive (the search box has the focus while it is open).
    public function focus-keys() {
        keys.focus();
    }

    background: Theme.bg;
    default-font-family: Theme.font;

    init => {
        keys.focus();
    }

    // The Back key. The Android backend reports Back as a key press; a press nobody accepts
    // closes the app, so Back is always accepted and Rust decides what it does. The scope wraps
    // the page, so a Back press that the search field ignores bubbles up to it.
    keys := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Back) {
                root.back-pressed();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // Not edge-to-edge: the system bars are k_bg in the Java theme, so the page starts below
            // them. Slint reports the bars as the safe area.
            padding-top: root.safe-area-insets.top;
            padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            spacing: 0px;

            KTopBar {
                title: root.bar-title;
                sub: root.bar-sub;
                left-icon: root.left-icon;
                left-mark: root.home;
                show-search: !root.selecting;
                show-sort: !root.selecting;
                left-glow-run: root.glow-run;
                search-icon: root.searching ? "close" : "search";
                show-chevron: root.marks-ok;
                titles-enabled: root.marks-ok;
                left-clicked => {
                    root.left-clicked();
                }
                titles-clicked => {
                    root.titles-clicked();
                }
                search-clicked => {
                    root.search-clicked();
                }
                sort-clicked => {
                    root.sort-clicked();
                }
                more-clicked => {
                    root.more-clicked();
                }
            }

            // searchRow: padding 12 / 0 / 12 / 8, the field takes the width
            if root.searching: HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 8px;
                KTextField {
                    horizontal-stretch: 1;
                    placeholder: "Search";
                    autofocus: true;
                    edited(text) => {
                        root.query-edited(text);
                    }
                }
            }

            // page.addView(line): 1 dp, k_line
            Rectangle {
                height: Theme.hair;
                background: Theme.line;
            }

            // banner: 13 sp on k_warn_bg, padding 16 / 10
            if root.banner-text != "": Rectangle {
                height: banner-label.preferred-height + 20px;
                background: Theme.warn-bg;
                banner-label := Text {
                    x: 16px;
                    y: 10px;
                    width: parent.width - 32px;
                    text: root.banner-text;
                    color: Theme.text;
                    font-size: Theme.sp(13px);
                    wrap: word-wrap;
                }
            }

            // body: a FrameLayout in the Java; children are stacked, the last one is on top
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // pullPanel: behind the list, as tall as the list has been pulled down
                KPullPanel {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: list.shift;
                    visible: list.shift > 0.5px;
                    opacity: Math.min(1, list.shift / 42px);
                    type-text: root.pull-type;
                    free-text: root.pull-free;
                    name-text: root.pull-name;
                    size-text: root.pull-size;
                    used: root.pull-used;
                }

                list := KFileList {
                    width: parent.width;
                    height: parent.height;
                    pull-enabled: root.pull-enabled;
                    rows: root.rows;
                    up-row: root.up-row;
                    has-where: root.has-where;
                    bottom-pad: root.bar-shown ? bar.height + 24px : 10px;
                    row-clicked(i) => {
                        root.row-clicked(i);
                    }
                    row-long-pressed(i) => {
                        root.row-long-pressed(i);
                    }
                    scrolled(y) => {
                        root.list-scrolled(y);
                    }
                    pull-started => {
                        root.pull-started();
                    }
                    pull-ended(refresh) => {
                        root.pull-ended();
                        if (refresh) {
                            root.refreshing = true;
                            root.refresh-requested();
                        }
                    }
                }

                // SwipeRefreshLayout's circle, above the list
                KRefreshCircle {
                    width: parent.width;
                    height: parent.height;
                    drag: list.over;
                    pulling: list.held;
                    refreshing: root.refreshing;
                }

                if root.empty-text != "": Text {
                    x: 32px;
                    y: root.empty-top + list.shift;
                    width: parent.width - 64px;
                    text: root.empty-text;
                    color: Theme.text2;
                    font-size: Theme.sp(15px);
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                // fab: WRAP_CONTENT x 48 dp, bottom right, 16 dp from both edges
                KFab {
                    x: parent.width - self.width - 16px;
                    y: parent.height - self.height - 16px;
                    shown: root.fab-shown;
                    clicked => {
                        root.new-clicked();
                    }
                }

                // bottomBar: surface, 1 dp line, radius 20, 6 dp padding, 12 dp from the sides and bottom;
                // it slides up 70 dp while it fades in (240 ms) and back out (160 ms)
                bar := Rectangle {
                    property <[string]> icons: ["copy", "move", "delete", "archive"];
                    property <[string]> captions: ["Copy", "Move", "Delete", "Pack"];
                    property <length> cell: (self.width - 12px) / 4;
                    x: 12px;
                    y: parent.height - self.height - 12px + (root.bar-shown ? 0px : 70px);
                    width: parent.width - 24px;
                    height: (root.paste-mode ? paste-col.preferred-height : tile-probe.preferred-height) + 12px;
                    background: Theme.surface;
                    border-radius: 20px;
                    border-width: Theme.hair;
                    border-color: Theme.line;
                    drop-shadow-color: #00000040;
                    drop-shadow-blur: 16px;
                    drop-shadow-offset-y: 4px;
                    opacity: root.bar-shown ? 1 : 0;
                    visible: self.opacity > 0.01;
                    animate opacity {
                        duration: root.bar-shown ? Theme.dur(240ms) : Theme.dur(160ms);
                        easing: ease-out;
                    }
                    animate y {
                        duration: root.bar-shown ? Theme.dur(240ms) : Theme.dur(160ms);
                        easing: ease-out;
                    }

                    // measures a tile, so that the bar is as high as its tiles plus the 6 dp padding
                    tile-probe := KTile {
                        visible: false;
                        icon: "copy";
                        label: "Copy";
                    }

                    for caption[i] in self.captions: KTile {
                        x: 6px + i * bar.cell;
                        y: 6px;
                        width: bar.cell;
                        visible: !root.paste-mode;
                        icon: bar.icons[i];
                        label: caption;
                        tint: i == 2 ? Theme.danger : i == 3 ? Theme.accent : Theme.text;
                        clicked => {
                            root.bar-clicked(i);
                        }
                    }

                    // The paste row (bottomBar while items are held): the title (15 sp bold) and
                    // "Into <folder>" (12 sp), then New folder, Cancel and Paste here / Move here.
                    paste-col := VerticalLayout {
                        x: 6px;
                        y: 6px;
                        width: parent.width - 12px;
                        height: parent.height - 12px;
                        visible: root.paste-mode;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 2px;
                            Text {
                                text: root.paste-title;
                                color: Theme.text;
                                font-size: Theme.sp(15px);
                                font-weight: Theme.bold;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                            Text {
                                text: root.paste-sub;
                                color: Theme.text2;
                                font-size: Theme.sp(12px);
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 2px;
                            padding-right: 4px;
                            padding-top: 4px;
                            padding-bottom: 2px;
                            KTile {
                                icon: "new_folder";
                                label: "New folder";
                                tint: Theme.accent;
                                clicked => {
                                    root.paste-new-folder();
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                KButton {
                                    text: "Cancel";
                                    kind: 2;
                                    clicked => {
                                        root.paste-cancel();
                                    }
                                }
                            }
                            Rectangle {
                                width: 6px;
                            }
                            VerticalLayout {
                                alignment: center;
                                KButton {
                                    text: root.paste-here-text;
                                    kind: 0;
                                    clicked => {
                                        root.paste-here();
                                    }
                                }
                            }
                        }
                    }
                }

                // permView: opaque, so it covers everything above; 32 dp padding, content centred
                if root.permission-missing: Rectangle {
                    background: Theme.bg;
                    TouchArea { }
                    VerticalLayout {
                        padding: 32px;
                        alignment: center;
                        Text {
                            text: "Kiln needs access to your files to open, create and unpack archives and to manage files. Nothing leaves your phone.";
                            color: Theme.text;
                            font-size: Theme.sp(15px);
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 16px;
                        }
                        HorizontalLayout {
                            alignment: center;
                            KButton {
                                text: "Allow access to files";
                                kind: 0;
                                clicked => {
                                    root.allow-access();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // The bookmarks drop-down (showBookmarks): its frame starts at the bottom of the title block,
    // 6 dp padding + 48 dp below the top of the page.
    KMarksPopup {
        width: 100%;
        height: 100%;
        shown: root.marks-shown;
        rows: root.mark-rows;
        has-action: root.mark-has-action;
        action-icon: root.mark-action-icon;
        action-label: root.mark-action-label;
        anchor-y: root.safe-area-insets.top + 54px;
        dismissed => {
            root.marks-dismissed();
        }
        row-clicked(i) => {
            root.mark-clicked(i);
        }
        row-removed(i) => {
            root.mark-removed(i);
        }
        row-icon(i) => {
            root.mark-icon-clicked(i);
        }
        action-clicked => {
            root.mark-action-clicked();
        }
    }

    // Sort by: Name, Size, Date modified, Type, then Ascending and Descending (sortSheet).
    KSheet {
        width: 100%;
        height: 100%;
        shown: root.sort-sheet-shown;
        title: "Sort by";
        buttons: [];
        kinds: [];
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        cancelled => {
            root.sort-dismissed();
        }
        for option[i] in ["Name", "Size", "Date modified", "Type"]: KSheetOption {
            label: option;
            selected: root.sort-key == i;
            clicked => {
                root.sort-key-chosen(i);
            }
        }
        Rectangle {
            height: 6px;
        }
        KSheetOption {
            label: "Ascending";
            selected: root.sort-asc;
            clicked => {
                root.sort-asc-chosen(true);
            }
        }
        KSheetOption {
            label: "Descending";
            selected: !root.sort-asc;
            clicked => {
                root.sort-asc-chosen(false);
            }
        }
    }

    // The message sheet: above the page, below the toast.
    KSheet {
        width: 100%;
        height: 100%;
        shown: root.sheet-shown;
        title: root.sheet-title;
        buttons: ["OK"];
        kinds: [0];
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        button-clicked(i) => {
            root.sheet-dismissed();
        }
        cancelled => {
            root.sheet-dismissed();
        }
        KSheetText {
            text: root.sheet-body;
        }
    }

    // The dialog sheet: above the message sheet, below the toast. The field exists only while the
    // sheet is shown, so it takes the keyboard each time it opens and lets go of it on close.
    KSheet {
        width: 100%;
        height: 100%;
        shown: root.dlg-shown;
        title: root.dlg-title;
        buttons: root.dlg-buttons;
        kinds: root.dlg-kinds;
        cancelable: root.dlg-cancelable;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        button-clicked(i) => {
            root.dlg-button-clicked(i);
        }
        cancelled => {
            root.dlg-cancelled();
        }
        if root.dlg-body != "": KSheetText {
            text: root.dlg-body;
        }
        for option[i] in root.dlg-options: KSheetOption {
            icon: option.icon;
            label: option.label;
            sub: option.sub;
            selected: option.selected;
            clicked => {
                root.dlg-option-clicked(i);
            }
        }
        if root.dlg-has-field && root.dlg-shown: KTextField {
            secret: root.dlg-secret;
            placeholder: root.dlg-placeholder;
            autofocus: true;
            select-end: root.dlg-select-end;
            text <=> root.dlg-text;
            edited => {
                root.dlg-error = "";
            }
        }
        if root.dlg-error != "" && root.dlg-has-field: Text {
            text: root.dlg-error;
            color: Theme.danger;
            font-size: Theme.sp(12px);
            wrap: word-wrap;
        }
    }

    // The Properties sheet (Props.show): above the dialog sheet. The name, headings and "label
    // value" rows (label 128 dp, bold, muted), then the check box, then Copy and OK.
    KSheet {
        width: 100%;
        height: 100%;
        shown: root.props-shown;
        title: "Properties";
        buttons: ["Copy", "OK"];
        kinds: [2, 0];
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        button-clicked(i) => {
            root.props-button-clicked(i);
        }
        cancelled => {
            root.props-cancelled();
        }
        for row in root.props-rows: VerticalLayout {
            padding-top: row.kind == 1 ? 10px : row.kind == 2 ? 3px : 0px;
            padding-bottom: row.kind == 2 ? 3px : 2px;
            if row.kind == 0: Text {
                text: row.label;
                color: Theme.text;
                font-size: Theme.sp(18px);
                font-weight: Theme.bold;
                wrap: word-wrap;
            }
            if row.kind == 1: Text {
                text: row.label;
                color: Theme.accent;
                font-size: Theme.sp(15px);
                font-weight: Theme.bold;
                wrap: word-wrap;
            }
            if row.kind == 2: HorizontalLayout {
                Text {
                    min-width: 128px;
                    max-width: 128px;
                    horizontal-stretch: 0;
                    text: row.label;
                    color: Theme.text2;
                    font-size: Theme.sp(14px);
                    font-weight: Theme.bold;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
                Text {
                    horizontal-stretch: 1;
                    text: row.value;
                    color: Theme.text;
                    font-size: Theme.sp(14px);
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }
        if root.props-has-nomedia: HorizontalLayout {
            alignment: start;
            padding-top: 6px;
            KCheck {
                text: "Disable media scanning";
                checked <=> root.props-nomedia;
                toggled(on) => {
                    root.props-nomedia-toggled(on);
                }
            }
        }
    }

    // The Pack sheet (MainActivity.packDialog): above the dialog sheet. Name, folder and Browse, the
    // encryption box with the password fields (only while it is ticked, like the Java), the
    // options and a note. A bad field gets a red line and the sheet stays open (Rust decides).
    KSheet {
        width: 100%;
        height: 100%;
        shown: root.pack-shown;
        title: root.pack-title;
        buttons: ["Cancel", "Create"];
        kinds: [2, 0];
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        button-clicked(i) => {
            root.pack-button-clicked(i);
        }
        cancelled => {
            root.pack-cancelled();
        }
        KFormField {
            placeholder: "Name";
            text <=> root.pack-name;
            error <=> root.pack-name-error;
        }
        Rectangle {
            height: 8px;
        }
        KFormField {
            placeholder: "Save in";
            text <=> root.pack-where;
            error <=> root.pack-where-error;
        }
        Rectangle {
            height: 8px;
        }
        KButton {
            text: "Browse";
            kind: 1;
            clicked => {
                root.pack-browse-clicked();
            }
        }
        Rectangle {
            height: 8px;
        }
        KCheck {
            text: "Encrypt with a password";
            checked <=> root.pack-enc;
            toggled => {
                root.pack-options-changed();
            }
        }
        if root.pack-enc: VerticalLayout {
            KFormField {
                placeholder: "Password (8+ characters)";
                secret: !root.pack-show-pw;
                text <=> root.pack-pw1;
                error <=> root.pack-pw1-error;
            }
            Rectangle {
                height: 8px;
            }
            KFormField {
                placeholder: "Repeat password";
                secret: !root.pack-show-pw;
                text <=> root.pack-pw2;
                error <=> root.pack-pw2-error;
            }
            KCheck {
                text: "Show passwords";
                checked <=> root.pack-show-pw;
            }
            KCheck {
                text: "Don't compress (faster for photos, music, video)";
                checked <=> root.pack-store;
            }
        }
        KCheck {
            text: "Separate archive for each file";
            checked <=> root.pack-each;
            toggled => {
                root.pack-options-changed();
            }
        }
        KCheck {
            text: "Delete original files after packing";
            checked <=> root.pack-wipe;
        }
        if root.pack-note != "": Text {
            text: root.pack-note;
            color: Theme.text2;
            font-size: Theme.sp(12px);
            wrap: word-wrap;
        }
    }

    // The Pack result sheet (MainActivity.packResult): above the Pack sheet. A 54 dp tile with the
    // icon, the heading and the archive's name; then, when kiln's line could be read, three number
    // tiles and the compression card; then the details and OK.
    KSheet {
        width: 100%;
        height: 100%;
        shown: root.pack-res-shown;
        buttons: ["OK"];
        kinds: [0];
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        button-clicked(i) => {
            root.pack-res-dismissed();
        }
        cancelled => {
            root.pack-res-dismissed();
        }
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                width: 54px;
                height: 54px;
                background: Theme.accent.with-alpha(0.15);
                border-radius: 16px;
                Icon {
                    x: 13px;
                    y: 13px;
                    width: 28px;
                    height: 28px;
                    name: root.pack-res-icon;
                    tint: Theme.accent;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.pack-res-heading;
                    color: Theme.text;
                    font-size: Theme.sp(18px);
                    font-weight: Theme.bold;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Text {
                    text: root.pack-res-name;
                    color: Theme.text2;
                    font-size: Theme.sp(13px);
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }
        Rectangle {
            height: 16px;
        }
        if root.pack-res-has-stats: VerticalLayout {
            HorizontalLayout {
                spacing: 8px;
                KStatTile {
                    big: root.pack-res-n-big;
                    small: root.pack-res-n-label;
                }
                KStatTile {
                    big: root.pack-res-stored;
                    small: "stored";
                }
                KStatTile {
                    big: root.pack-res-time;
                    small: "took";
                }
            }
            Rectangle {
                height: 16px;
            }
            Rectangle {
                background: Theme.chip;
                border-radius: 14px;
                preferred-height: cmp.preferred-height;
                cmp := VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    HorizontalLayout {
                        Text {
                            horizontal-stretch: 1;
                            text: "Compression";
                            color: Theme.text2;
                            font-size: Theme.sp(13px);
                        }
                        Text {
                            text: root.pack-res-saved;
                            color: Theme.accent;
                            font-size: Theme.sp(13px);
                            font-weight: Theme.bold;
                        }
                    }
                    Rectangle {
                        height: 8px;
                    }
                    KMeter {
                        value: root.pack-res-frac;
                    }
                    Rectangle {
                        height: 6px;
                    }
                    Text {
                        text: root.pack-res-caption;
                        color: Theme.text2;
                        font-size: Theme.sp(12px);
                        wrap: word-wrap;
                    }
                }
            }
            Rectangle {
                height: 14px;
            }
        }
        KDetailCard {
            rows: root.pack-res-rows;
        }
    }

    // The folder icon picker (iconPicker): above the dialog sheet. A swatch keeps the sheet open
    // (Rust saves the colour and moves the tick); an icon or a button is for Rust to act on.
    KSheet {
        width: 100%;
        height: 100%;
        shown: root.pick-shown;
        title: root.pick-title;
        buttons: ["Use default", "Cancel"];
        kinds: [1, 2];
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        button-clicked(i) => {
            root.pick-button-clicked(i);
        }
        cancelled => {
            root.pick-cancelled();
        }
        // 11 cells (default + 10 colours), 6 to a row; the last row is padded with empty cells
        if root.pick-has-colors: VerticalLayout {
            for r in [0, 1]: HorizontalLayout {
                for c in 6: KSwatch {
                    property <int> at: r * 6 + c;
                    visible: self.at < 1 + root.pick-colors.length;
                    dot: self.at == 0 ? Theme.accent : root.pick-colors[self.at - 1];
                    current: root.pick-color-index == self.at;
                    clicked => {
                        root.pick-swatch-clicked(self.at);
                    }
                }
            }
        }
        if root.pick-has-colors: Rectangle {
            height: 10px;
        }
        // 4 columns; 5 rows hold the 18 icons, the last row is padded with empty cells
        VerticalLayout {
            for r in [0, 1, 2, 3, 4]: HorizontalLayout {
                for c in 4: KPickCell {
                    property <int> at: r * 4 + c;
                    visible: self.at < root.pick-icons.length;
                    icon: root.pick-icons[self.at].icon;
                    label: root.pick-icons[self.at].label;
                    current: root.pick-icons[self.at].current;
                    tint: root.pick-tint;
                    clicked => {
                        root.pick-icon-clicked(self.at);
                    }
                }
            }
        }
    }

    // The progress sheet (MainActivity.ProgressUi): above the dialog sheet, below the toast. Back
    // and a tap outside do nothing; only Cancel acts, when there is one.
    KSheet {
        width: 100%;
        height: 100%;
        shown: root.prog-shown;
        title: root.prog-title;
        buttons: root.prog-cancellable ? ["Cancel"] : root.prog-no-buttons;
        kinds: [1];
        buttons-enabled: root.prog-cancel-enabled;
        cancelable: false;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        button-clicked(i) => {
            root.prog-cancel-clicked();
        }
        // the file line (14 sp, muted) and the percent (16 sp bold), 12 dp apart
        HorizontalLayout {
            spacing: 12px;
            min-height: Theme.sp(19px);
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: root.prog-line;
                    color: Theme.text2;
                    font-size: Theme.sp(14px);
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
            Text {
                text: root.prog-pct;
                color: Theme.text;
                font-size: Theme.sp(16px);
                font-weight: Theme.bold;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 12px;
        }
        KProgressBar {
            value: root.prog-frac;
            indeterminate: root.prog-indeterminate;
        }
    }

    // The About sheet (MainActivity.showAbout): the mark in a 72 dp tile, "Kiln", the version chip
    // and the tagline, then the detail card and OK.
    KSheet {
        width: 100%;
        height: 100%;
        shown: root.about-shown;
        buttons: ["OK"];
        kinds: [0];
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        button-clicked(i) => {
            root.about-dismissed();
        }
        cancelled => {
            root.about-dismissed();
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 72px;
                height: 72px;
                background: Theme.chip;
                border-radius: 20px;
                KMark {
                    x: 14px;
                    y: 14px;
                    width: 44px;
                    height: 44px;
                }
            }
        }
        Rectangle {
            height: 12px;
        }
        Text {
            text: "Kiln";
            color: Theme.text;
            font-size: Theme.sp(24px);
            font-weight: Theme.bold;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 6px;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                background: Theme.chip;
                border-radius: 12px;
                preferred-width: about-chip.preferred-width;
                preferred-height: about-chip.preferred-height;
                about-chip := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    Text {
                        text: root.about-version;
                        color: Theme.accent;
                        font-size: Theme.sp(13px);
                        font-weight: Theme.bold;
                    }
                }
            }
        }
        Rectangle {
            height: 10px;
        }
        Text {
            text: "Open, create and unpack Kiln archives, and manage ordinary files.";
            color: Theme.text2;
            font-size: Theme.sp(14px);
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle {
            height: 16px;
        }
        KDetailCard {
            rows: root.about-rows;
        }
        Rectangle {
            height: 4px;
        }
    }

    // Toast layer: above everything, never takes touches.
    KToast {
        width: 100%;
        height: 100%;
        message: root.toast-text;
        shown: root.toast-shown;
        inset-bottom: root.safe-area-insets.bottom;
    }
}
