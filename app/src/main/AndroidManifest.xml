<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Kiln works on ordinary files and folders, like a file manager -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- keeps long pack/unpack jobs alive when you leave the app, with a progress notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Slint draws with Skia on OpenGL ES (or Vulkan where the phone has it) -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- lets "Open with..." list the apps that can open a file (Android 11+ package visibility) -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- hasCode="false": the app is native code only. There is no Java or Kotlin class in the APK;
         android.app.NativeActivity (part of Android) loads libkiln_android.so and runs android_main. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasCode="false"
        android:theme="@style/KilnTheme">

        <!-- configChanges: the app handles these itself (dark mode and font size change live, a
             rotation does not restart it), as the Java MainActivity did for the first four. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode|fontScale|density|layoutDirection|locale">
            <meta-data android:name="android.app.lib_name" android:value="kiln_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ZArchiver and other file managers: "Open with Kiln" on a .kiln file -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.kiln" />
                <data android:pathPattern=".*\\..*\\.kiln" />
                <data android:pathPattern=".*\\..*\\..*\\.kiln" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.kiln" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-kiln" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.kiln" />
                <data android:pathPattern=".*\\..*\\.kiln" />
                <data android:pathPattern=".*\\..*\\..*\\.kiln" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.kiln" />
            </intent-filter>
        </activity>
    </application>
</manifest>
